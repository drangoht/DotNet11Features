<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Exemple 15 : le nouveau modèle de sécurité mémoire de C# 15 est en PREVIEW.
    Il demande trois réglages, d'où ce projet séparé : le reste de la solution reste en C# 15 stable.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <LangVersion>preview</LangVersion>
    <Features>$(Features);updated-memory-safety-rules</Features>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

</Project>
