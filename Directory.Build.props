<Project>
  <!-- Réglages communs à toute la solution : .NET 11, C# 15 (la version par défaut pour net11.0). -->
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Un switch qui oublie un cas d'union ou de hiérarchie fermée n'est qu'un avertissement (CS8509) :
         on le transforme en erreur, c'est tout l'intérêt de ces deux fonctionnalités. -->
    <WarningsAsErrors>$(WarningsAsErrors);CS8509</WarningsAsErrors>
  </PropertyGroup>
</Project>
