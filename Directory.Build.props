<Project>
  <!-- Settings shared by the whole solution: .NET 11, C# 15 (the default language version for net11.0). -->
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- A switch that forgets a case of a union or a closed hierarchy is only a warning (CS8509):
         turn it into an error, that is the whole point of these two features. -->
    <WarningsAsErrors>$(WarningsAsErrors);CS8509</WarningsAsErrors>
  </PropertyGroup>
</Project>
